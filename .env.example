# Real mode loads this file only with --env-file .env; Mock ignores it.
# Keep real credentials in the ignored local .env, never in this example.
MODEL_PROVIDER=deepseek
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash
MODEL_API_KEY=
MODEL_TOKEN_PARAMETER=max_tokens
MODEL_MAX_OUTPUT_TOKENS=1024
MODEL_STRICT_TOOLS=false
MODEL_MAX_REQUEST_BYTES=2097152
MODEL_MAX_RESPONSE_BYTES=1048576
# Execution budgets are controlled by CLI flags, not environment variables.
